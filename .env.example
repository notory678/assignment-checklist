# Optional: leave empty to use the offline, rule-based extractor.
# Copy this file to .env, then edit .env locally. Never commit actual keys.
# Create a fine-grained token at https://huggingface.co/settings/tokens
# Enable "Make calls to Inference Providers" for the token.
HF_TOKEN=
# Use a model served by Inference Providers: https://huggingface.co/playground
# Set an exact model ID, optionally with a provider suffix: organization/model:provider
# Both the model and provider must support Chat Completions and json_schema output.
HF_MODEL=
