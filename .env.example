# Use a Groq Free plan account. Do not upgrade the account to a paid plan.
# Create a key at https://console.groq.com/keys and save it only in .env.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional local backup. It does not require an external API token.
# Docker Desktop connects to the Ollama server running on this Mac.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
# To make local AI the main method, set AI_PROVIDER=ollama.
